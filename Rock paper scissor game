
#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main() {
    int user, computer;

    srand(time(0));

    cout << "=== ROCK PAPER SCISSORS GAME ===\n";
    cout << "1. Rock\n";
    cout << "2. Paper\n";
    cout << "3. Scissors\n";

    cout << "Enter your choice (1-3): ";
    cin >> user;

    if (user < 1 || user > 3) {
        cout << "Invalid choice!";
        return 0;
    }

    computer = rand() % 3 + 1;

    cout << "You chose: "
         << (user == 1 ? "Rock" :
             user == 2 ? "Paper" : "Scissors") << endl;

    cout << "Computer chose: "
         << (computer == 1 ? "Rock" :
             computer == 2 ? "Paper" : "Scissors") << endl;

    if (user == computer) {
        cout << "Result: It's a Draw!";
    }
    else if ((user == 1 && computer == 3) ||
             (user == 2 && computer == 1) ||
             (user == 3 && computer == 2)) {
        cout << "Result: You Win!";
    }
    else {
        cout << "Result: Computer Wins!";
    }

    return 0;
}
